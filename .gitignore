# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/*
Dockerfile.cross

# Test binary, built with `go test -c`
*.test
test/e2e/.vault-token

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Go workspace file
go.work

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*

# editor and IDE paraphernalia
.idea
.vscode
*.swp
*.swo
*~

# Claude Code local state (transcripts, agent scratch, personal settings)
.claude/

# Cross-compiled manager binary used by Dockerfile.local for fast kind-cluster
# rebuilds. Produced by `GOOS=linux GOARCH=arm64 go build -o manager-linux-...`.
# Build artifact, not source.
manager-linux-*-for-build

# Working notes — implementation plans, checklists, exploratory designs,
# architecture decision records. Only the user-facing reference
# (docs/crd-reference.md) is tracked.
docs/plans/
docs/design/
docs/adr/

# Project-level Claude Code instructions (kept locally, not tracked).
CLAUDE.md

# Operator helm chart is regenerated by `make helm-release-operator` from
# config/default kustomize output. Do not commit the generated chart.
charts/openbao-config-operator/

# Packaged chart artifacts produced by `helm package`.
dist/

# Shared helm release pipeline pulled from stakater/.github at first use.
makefiles/

hack/kv*
hack/eso*